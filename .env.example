# Secrets are configured in the n8n / server environment.
# Never commit real values to GitHub.

TELEGRAM_BOT_TOKEN=REPLACE_WITH_TELEGRAM_BOT_TOKEN
OPENAI_API_KEY=REPLACE_WITH_OPENAI_API_KEY
POSTGRES_PASSWORD=REPLACE_WITH_POSTGRES_PASSWORD

# FastAPI backend (backend/.env / docker-compose env_file)
N8N_INTERVIEW_WEBHOOK_URL=https://behololakug.beget.app/webhook/orto-ai

# Хранилище файлов (скриншоты интервью). В контейнере каталог монтируется как /app/storage.
STORAGE_DIR=/app/storage

# Поиск по базе знаний OneDrive (Microsoft Graph API).
# ONEDRIVE_MODE: graph (реальный поиск) | mock (локальная mock-база для отладки) | off
# Для graph укажите credentials приложения Microsoft Entra (client credentials):
ONEDRIVE_MODE=graph
MS_GRAPH_TENANT_ID=REPLACE_WITH_TENANT_ID
MS_GRAPH_CLIENT_ID=REPLACE_WITH_CLIENT_ID
MS_GRAPH_CLIENT_SECRET=REPLACE_WITH_CLIENT_SECRET
MS_GRAPH_DRIVE_ID=REPLACE_WITH_DRIVE_ID
